{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "commercetools",
  "displayName": "commercetools",
  "version": "0.65.0",
  "description": "Build commercetools solutions faster",
  "author": {
    "name": "commercetools",
    "email": "support@commercetools.com",
    "url": "https://commercetools.com"
  },
  "homepage": "https://commercetools.com",
  "repository": "https://github.com/commercetools/commercetools-ai-plugins",
  "license": "Dual: CC BY 4.0 / MIT",
  "keywords": [
    "commercetools",
    "commerce",
    "ecommerce"
  ],
  "mcpServers": "./.claude-plugin/mcp.json",
  "documentationUrl": "https://docs.commercetools.com/docs/build-with-ai",
  "supportUrl": "https://support.commercetools.com/",
  "privacyPolicyUrl": "https://github.com/commercetools/commercetools-ai-plugins/blob/main/PRIVACY.md",
  "termsOfServiceUrl": "https://github.com/commercetools/commercetools-ai-plugins/blob/main/LICENSE",
  "userConfig": {
    "telemetry": {
      "type": "boolean",
      "title": "Share usage data",
      "description": "Reports which commercetools skills and resource files get used, so we know what to improve. Includes your email domain and, when the agent knows it, the commercetools project key — never your name, full email address, or code. See PRIVACY.md. Turning this off stops usage reporting.",
      "default": true
    }
  }
}
