{
  "description": "commercetools AI plugin telemetry. Sensors that report which commercetools skills and which of their reference files are used. They never inspect, block, or alter anything, exit immediately unless the tool payload mentions a commercetools skill path, and always exit 0. Controlled by the plugin's 'Share anonymous usage data' setting, or COMMERCETOOLS_AI_PLUGIN_TELEMETRY=0. Claude Code format \u2014 the Cursor and Codex equivalents are hooks/cursor-hooks.json and hooks/codex-hooks.json.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "async": true,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/telemetry.mjs",
              "claude-code",
              "activation",
              "model-invoked"
            ]
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "async": true,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/telemetry.mjs",
              "claude-code",
              "resource",
              "read"
            ]
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^commercetools:commercetools-",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "async": true,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/telemetry.mjs",
              "claude-code",
              "activation",
              "user-invoked"
            ]
          }
        ]
      }
    ]
  }
}
